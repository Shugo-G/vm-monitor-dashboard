# Copiá este archivo como .env y completá los valores
# Generá una secret key con: python3 -c "import secrets; print(secrets.token_hex(50))"

DJANGO_SECRET_KEY=change-this-to-a-long-random-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=shugovision.dposs.gob.ar,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://shugovision.dposs.gob.ar,http://localhost:8080
DB_PATH=/app/data/db.sqlite3
TZ=America/Argentina/Ushuaia
